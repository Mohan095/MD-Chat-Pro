# ============================================================================
# MD Chat Pro - Firebase Environment Configuration
# Copy this file to `.env` and fill in your Firebase project's web credentials.
# Never commit `.env` or any private service account keys to version control!
# ============================================================================

# Vite / Modern Frontend Prefix (Recommended)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
VITE_FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com
VITE_FIREBASE_VAPID_KEY=your_optional_fcm_web_push_vapid_key

# Optional Create-React-App Legacy Prefix (Also supported automatically)
# REACT_APP_FIREBASE_API_KEY=your_firebase_api_key_here
# REACT_APP_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
# REACT_APP_FIREBASE_PROJECT_ID=your-project-id
# REACT_APP_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
# REACT_APP_FIREBASE_MESSAGING_SENDER_ID=123456789012
# REACT_APP_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
# REACT_APP_FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com
