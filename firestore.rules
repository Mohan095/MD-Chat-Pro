rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Helper Functions
    // =========================================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function getChatData(chatId) {
      return get(/databases/$(database)/documents/chats/$(chatId)).data;
    }

    function isChatParticipant(chatId) {
      return isAuthenticated() && (request.auth.uid in getChatData(chatId).participants);
    }

    // =========================================================================
    // Users Collection (/users/{userId})
    // =========================================================================
    match /users/{userId} {
      // Any authenticated user can view basic user profiles to search & add friends
      allow read: if isAuthenticated();

      // Only the user themselves can create their profile document
      allow create: if isOwner(userId)
        && isValidString(request.resource.data.displayName, 2, 60)
        && request.resource.data.uid == userId;

      // Owner can update their own profile; friends can only update mutual friend list when accepting a request
      allow update: if isOwner(userId)
        || (
          isAuthenticated()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friends', 'updatedAt'])
        );

      allow delete: if isOwner(userId);
    }

    // =========================================================================
    // Friend Requests Collection (/friendRequests/{requestId})
    // =========================================================================
    match /friendRequests/{requestId} {
      allow read: if isAuthenticated() && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid == request.auth.uid
      );

      allow create: if isAuthenticated()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.status == 'pending';

      allow update: if isAuthenticated() && (
        resource.data.toUid == request.auth.uid ||
        resource.data.fromUid == request.auth.uid
      ) && request.resource.data.status in ['pending', 'accepted', 'rejected'];

      allow delete: if isAuthenticated() && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid == request.auth.uid
      );
    }

    // =========================================================================
    // Chats Collection (/chats/{chatId})
    // Private & Group conversations accessible ONLY to participants
    // =========================================================================
    match /chats/{chatId} {
      allow read: if isAuthenticated() && (
        request.auth.uid in resource.data.participants
      );

      allow create: if isAuthenticated()
        && (request.auth.uid in request.resource.data.participants)
        && request.resource.data.participants is list
        && request.resource.data.participants.size() >= 2
        && request.resource.data.type in ['direct', 'group'];

      allow update: if isAuthenticated() && (
        request.auth.uid in resource.data.participants
      );

      allow delete: if isAuthenticated() && (
        (resource.data.type == 'direct' && request.auth.uid in resource.data.participants) ||
        (resource.data.type == 'group' && request.auth.uid in resource.data.adminIds)
      );

      // =======================================================================
      // Messages Subcollection (/chats/{chatId}/messages/{messageId})
      // =======================================================================
      match /messages/{messageId} {
        allow read: if isChatParticipant(chatId);

        allow create: if isChatParticipant(chatId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.type in ['text', 'image', 'file', 'system']
          && (!('text' in request.resource.data) || request.resource.data.text.size() <= 4000);

        // Sender can edit/delete message; any participant can update reactions, readBy, deliveredTo, starredBy
        allow update: if isChatParticipant(chatId) && (
          resource.data.senderId == request.auth.uid ||
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['readBy', 'deliveredTo', 'reactions', 'starredBy', 'deletedFor'])
        );

        allow delete: if isChatParticipant(chatId)
          && resource.data.senderId == request.auth.uid;
      }
    }
  }
}
